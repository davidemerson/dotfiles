# Backups
backups/
*.backup

# Temporary files
*.tmp
*.swp
*~

# Private assets — licensed, fetched at provision time (see provision.sh,
# fetch_private_assets). Berkeley Mono is a commercial face whose binary is
# watermarked with the licensee's own license ID; it must never be committed
# to this public repo.
dotfiles/.fonts/bmv.otf
scripts/BerkeleyMonoNNIX.psf.gz
# ...and the sealed bundle scripts/seal-secrets.sh builds from them.
nnix-secrets.tar.gpg

# SSH keys (never commit these!)
dotfiles/.ssh/id_*
dotfiles/.ssh/*.pem
dotfiles/.ssh/authorized_keys

# Sublime Text session files
dotfiles/.config/sublime-text-3/Local/
dotfiles/.config/sublime-text-3/Packages/User/Package Control.cache/
dotfiles/.config/sublime-text-3/Packages/User/*.sublime-session
dotfiles/.config/sublime-text-3/Packages/User/*.sublime-workspace

# Log files
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
