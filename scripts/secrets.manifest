# Files sealed into the encrypted provisioning bundle by scripts/seal-secrets.sh
# and unpacked by provision.sh (unseal_secrets). Listing a path here is what
# makes it a private asset -- nothing else needs to change.
#
# @@TREE@@ = the root of this repository as provision.sh sees it
# @@HOME@@ = the target user's home directory
#
# name                     destination                                 mode
bmv.otf                    @@TREE@@/dotfiles/.fonts/bmv.otf            0644
BerkeleyMonoNNIX.psf.gz    @@TREE@@/scripts/BerkeleyMonoNNIX.psf.gz    0644
