# Files sealed into the encrypted provisioning bundle by scripts/seal-secrets.sh
# and unpacked by provision.sh (unseal_secrets). Listing a path here is what
# makes it a private asset -- nothing else needs to change.
#
# @@TREE@@ = the root of this repository as provision.sh sees it
# @@HOME@@ = the target user's home directory
# @@USER@@ = the target user (owner column; omit the column for root)
#
# The fifth column is an optional HOST SCOPE, defaulting to @@ANY@@. Leave it
# off for anything belonging to the *user* -- their font, their SSH identity.
# Set it to a short hostname for anything identifying a *machine*: two hosts
# sharing one ZeroTier identity collide, and a shared SSH host key lets either
# impersonate the other.
#
# A 0600 mode also gets its parent directory created 0700, which ~/.ssh needs:
# ssh refuses a key whose directory is group- or world-accessible.
#
# name                     destination                                 mode  owner
bmv.otf                    @@TREE@@/dotfiles/.fonts/bmv.otf            0644  root
BerkeleyMonoNNIX.psf.gz    @@TREE@@/scripts/BerkeleyMonoNNIX.psf.gz    0644  root

# The SSH identity. NOTE: the sealed copy is the PASSPHRASE-PROTECTED one, so
# the bundle passphrase alone does not yield the key -- an attacker needs both
# it and the key's own passphrase. Do not replace this with a passphraseless
# copy for convenience; that is the whole of the defence in depth here.
id_d_nnix.pem              @@HOME@@/.ssh/id_d_nnix.pem                 0600  @@USER@@
id_d_nnix.pub              @@HOME@@/.ssh/id_d_nnix.pub                 0644  @@USER@@

# authorized_keys is byte-for-byte the public key above -- one key, David's,
# the same on every host. So it is carried once and installed twice rather than
# sealed as a second copy. If you ever add a SECOND key to authorized_keys,
# this line stops being right: give it its own payload then.
id_d_nnix.pub              @@HOME@@/.ssh/authorized_keys               0600  @@USER@@

# Per-machine config for the `workstation` command. The tracked copy in this
# repo is intentionally blank, and provision.sh seeds but never overwrites it --
# so without this entry a rebuilt host silently gets the blank template back and
# `workstation` refuses to run until someone remembers why.
workstation.conf           @@HOME@@/.config/workstation.conf           0600  @@USER@@
